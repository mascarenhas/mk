-- File extension to MIME content-type lookup used by Context:type and send_file.

local const MIME_TYPES: {string: string} = {
  ["html"] = "text/html", ["htm"] = "text/html", ["css"] = "text/css",
  ["js"] = "text/javascript", ["mjs"] = "text/javascript",
  ["json"] = "application/json", ["map"] = "application/json",
  ["txt"] = "text/plain", ["text"] = "text/plain", ["csv"] = "text/csv",
  ["xml"] = "application/xml", ["svg"] = "image/svg+xml",
  ["png"] = "image/png", ["jpg"] = "image/jpeg", ["jpeg"] = "image/jpeg",
  ["gif"] = "image/gif", ["webp"] = "image/webp", ["ico"] = "image/x-icon",
  ["avif"] = "image/avif", ["bmp"] = "image/bmp",
  ["woff"] = "font/woff", ["woff2"] = "font/woff2", ["ttf"] = "font/ttf",
  ["otf"] = "font/otf", ["wasm"] = "application/wasm",
  ["pdf"] = "application/pdf", ["zip"] = "application/zip",
  ["gz"] = "application/gzip", ["tar"] = "application/x-tar",
  ["mp3"] = "audio/mpeg", ["ogg"] = "audio/ogg", ["wav"] = "audio/wav",
  ["mp4"] = "video/mp4", ["webm"] = "video/webm",
  ["md"] = "text/markdown", ["yaml"] = "application/yaml",
  ["yml"] = "application/yaml", ["form"] = "application/x-www-form-urlencoded",
  ["bin"] = "application/octet-stream",
}

-- ASCII-only lowering (independent of the process C locale); text without
-- uppercase letters is returned unchanged, without a replacement pass.
local function ascii_lower(text: string): string
  if strings.match(text, "[A-Z]") == nil then return text end
  local lowered = strings.gsub(text, "[A-Z]", function (letter: string): string
    return strings.char(strings.byte(letter, 1) + 32)
  end, nil)
  return lowered
end

-- Text-like media types receive a default UTF-8 charset parameter.
local function text_like(media: string): boolean
  return strings.sub(media, 1, 5) == "text/" or media == "application/json" or
    media == "application/javascript" or media == "application/xml" or
    media == "image/svg+xml" or media == "application/yaml"
end

-- `extension_or_mime` is a full MIME type (contains "/"), a dotted extension,
-- or a bare extension. Unknown extensions map to application/octet-stream.
local function content_type_for(extension_or_mime: string, charset: string?): string
  local media = extension_or_mime
  if not strings.find(media, "/") then
    local extension = ascii_lower(media)
    if strings.sub(extension, 1, 1) == "." then extension = strings.sub(extension, 2) end
    media = MIME_TYPES[extension] or "application/octet-stream"
  end
  if strings.find(media, ";") then return media end
  if charset then return media .. "; charset=" .. charset end
  if text_like(media) then return media .. "; charset=utf-8" end
  return media
end

-- Final path component extension including no dot, or "".
local function path_extension(file_path: string): string
  local found = ""
  for index = #file_path, 1, -1 do
    local byte = strings.byte(file_path, index)
    if byte == 46 then
      found = strings.sub(file_path, index + 1)
      break
    end
    if byte == 47 or byte == 92 then break end
  end
  return found
end
