-- Handlers, expected HTTP errors, the status catalog, and default error handlers.

--- A middleware or endpoint handler; call `ctx:next()` to continue the chain.
type Handler = function (Context): ()

--- Builds the response for an `HttpError` that escaped the handler chain.
type ErrorHandler = function (Context, HttpError): ()

--- An expected HTTP failure raised by handlers with `raise mk.HttpError(...)`.
-- @field status Final HTTP status (200..999; anything else becomes 500).
-- @field message Client-visible message.
-- @field code Optional stable machine-readable code.
-- @field cause Optional underlying error value.
record HttpError
  const status: integer
  const message: string
  const code: string?
  const cause: value
end

--- Build an HTTP error, defaulting the message to the status reason phrase.
function HttpError.new(status: integer, message: string?, code: string?, cause: value): HttpError
  local actual = status
  if actual < 200 or actual > 999 then actual = 500 end
  return { status = actual, message = message or status_message(actual), code = code, cause = cause }
end

local const STATUS_MESSAGES: {integer: string} = {
  [100] = "Continue", [101] = "Switching Protocols", [102] = "Processing",
  [103] = "Early Hints",
  [200] = "OK", [201] = "Created", [202] = "Accepted",
  [203] = "Non-Authoritative Information", [204] = "No Content",
  [205] = "Reset Content", [206] = "Partial Content", [207] = "Multi-Status",
  [208] = "Already Reported", [226] = "IM Used",
  [300] = "Multiple Choices", [301] = "Moved Permanently", [302] = "Found",
  [303] = "See Other", [304] = "Not Modified", [305] = "Use Proxy",
  [307] = "Temporary Redirect", [308] = "Permanent Redirect",
  [400] = "Bad Request", [401] = "Unauthorized", [402] = "Payment Required",
  [403] = "Forbidden", [404] = "Not Found", [405] = "Method Not Allowed",
  [406] = "Not Acceptable", [407] = "Proxy Authentication Required",
  [408] = "Request Timeout", [409] = "Conflict", [410] = "Gone",
  [411] = "Length Required", [412] = "Precondition Failed",
  [413] = "Content Too Large", [414] = "URI Too Long",
  [415] = "Unsupported Media Type", [416] = "Range Not Satisfiable",
  [417] = "Expectation Failed", [418] = "I'm a teapot",
  [421] = "Misdirected Request", [422] = "Unprocessable Content",
  [423] = "Locked", [424] = "Failed Dependency", [425] = "Too Early",
  [426] = "Upgrade Required", [428] = "Precondition Required",
  [429] = "Too Many Requests", [431] = "Request Header Fields Too Large",
  [451] = "Unavailable For Legal Reasons",
  [500] = "Internal Server Error", [501] = "Not Implemented",
  [502] = "Bad Gateway", [503] = "Service Unavailable",
  [504] = "Gateway Timeout", [505] = "HTTP Version Not Supported",
  [506] = "Variant Also Negotiates", [507] = "Insufficient Storage",
  [508] = "Loop Detected", [510] = "Not Extended",
  [511] = "Network Authentication Required",
}

--- Return the standard reason phrase for a status, or "Unknown Status Code".
function status_message(status: integer): string
  return STATUS_MESSAGES[status] or "Unknown Status Code"
end

--- Plain-text error response: the error status with its message as the body.
function default_error_handler(ctx: Context, err: HttpError)
  ctx:status(err.status):type("text/plain", "utf-8"):send_string(err.message)
end

--- JSON error response `{"status":...,"message":...,"code":...}`.
function json_error_handler(ctx: Context, err: HttpError)
  local body: {string: value} = {
    ["status"] = err.status,
    ["message"] = err.message,
    ["code"] = err.code,
  }
  ctx:status(err.status):json(body)
end
