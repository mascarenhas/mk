--- Expose selected environment variables as JSON (GoFiber envvar).
-- @module mk.middleware.env

local mk = import "mk"
local iteration = import "iteration"
local os = import "os"
local strings = import "string"

--- Environment export options.
-- @field export_vars Variable name to the default reported when it is unset.
record Config
  const export_vars: {string: string}?
end

-- Encode the export list as `name NUL default NUL ...` so the handler
-- captures one transferable string instead of a Map.
local function encode_exports(exports: {string: string}): string
  local out = strings.writer()
  for name, fallback in iteration.pairs(exports) do
    if name == "" or strings.find(name, "=") ~= nil or strings.find(name, "\0") ~= nil then
      raise "env: variable names must be nonempty and contain no '=' or NUL"
    end
    if strings.find(fallback, "\0") ~= nil then raise "env: default values must not contain NUL" end
    out:write(name .. "\0" .. fallback .. "\0")
  end
  return out:drain()
end

local function current_values(encoded: string): {string: value}
  local vars: {string: value} = {}
  local start = 1
  while start <= #encoded do
    local name_end = strings.find(encoded, "\0", start)
    local value_end = strings.find(encoded, "\0", name_end + 1)
    local name = strings.sub(encoded, start, name_end - 1)
    vars[name] = os.getenv(name) or strings.sub(encoded, name_end + 1, value_end - 1)
    start = value_end + 1
  end
  return vars
end

--- Serve `{"vars": {...}}` for GET/HEAD (current values, else defaults);
-- other methods get 405 with `Allow: GET, HEAD`.
function new(config: Config?): mk.Handler
  local encoded = ""
  if config ~= nil then
    local exports? = config.export_vars
    if exports ~= nil then encoded = encode_exports(exports) end
  end
  return function (ctx: mk.Context)
    local method = ctx:method()
    if method ~= "GET" and method ~= "HEAD" then
      ctx:set("Allow", "GET, HEAD")
      raise mk.HttpError(405)
    end
    local body: {string: value} = {["vars"] = current_values(encoded)}
    ctx:status(200):json(body)
  end
end
